# ============================================================
# XML E-Ticaret — ÜRETİM Ortam Değişkenleri (örnek)
# Kurulum: cp .env.production.example .env → değerleri sunucuda düzenle
# GİZLİ: Bu dosya sunucu dışına çıkmaz, repoya commit edilmez, web kökünde
#         olmamalıdır. İzin: chown www-data:www-data .env && chmod 640 .env
# Denetim: php bin/console doctor  (tüm kritik kontroller PASS olmalı)
# ============================================================

# Uygulama
APP_ENV=production
# Hata detayları EKRANA ASLA basılmasın: boş veya 0 (doctor FAIL verir)
APP_DEBUG=0
APP_TIMEZONE=Europe/Istanbul
# https zorunlu — sertifikayı kurduktan SONRA bu değeri güncelleyin
APP_URL=https://orneksite.com
# http→https 301 yönlendirmesi Nginx katmanında uygulanır (docs/deployment.md §9);
# APP_FORCE_HTTPS uygulama tarafı kontrolü için rezerve bayraktır.
APP_FORCE_HTTPS=true
# Host başlığı beyaz listesi (virgülle ayrılmış; boş = kısıt yok) — Nginx server_name ile eşleşmeli
APP_ALLOWED_HOSTS=orneksite.com,www.orneksite.com
# APP_KEY: openssl rand -base64 32 çıktısı (32+ byte, TEK SEFER üret)
APP_KEY=

# Veritabanı — AYRI uygulama kullanıcısı (root YASAK — doctor denetler)
# Kullanıcı/parola: docs/deployment.md §6 SQL bloğu
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xml_ecommerce
DB_USERNAME=ecommerce_app
DB_PASSWORD=GUCLU_PAROLA_BURAYA
DB_CHARSET=utf8mb4

# Oturum / Güvenlik
SESSION_NAME=xmlshop_session
# Sertifika aktifken true — çerezler yalnız HTTPS'te taşınır
SESSION_SECURE=true
SESSION_LIFETIME=2700

# Log
LOG_LEVEL=info

# XML import (XML_MAX_MEMORY_MB için PHP memory_limit üstünde olmalı — CLI 512M)
XML_UPLOAD_MAX_MB=100
XML_FETCH_TIMEOUT=30
XML_FETCH_MAX_REDIRECT=3
XML_MAX_MEMORY_MB=256

# XML senkronizasyon
XML_SYNC_BATCH=50
XML_PREVIEW_ROWS=20
# Gerçek güncel kur değerlerini girin
XML_RATE_USD=34.0
XML_RATE_EUR=37.0
XML_RATE_GBP=43.0

# Fiyatlandırma
PRICING_TAX_IN_SALE=0
PRICING_PROFIT_WARN=10

# İlk seed (yalnız database/seed.php ilk çalıştırmada; SONRA BU ÜÇ SATIRI SİLİN)
ADMIN_NAME=Site Yöneticisi
ADMIN_EMAIL=admin@orneksite.com
ADMIN_PASSWORD=

# iyzico — CANLI ödeme (gerçek anahtarlar YALNIZ sunucuda; repoya yazılmaz)
# Panel: https://merchant.iyzipay.com → Ayarlar → Anahtarlar
IYZICO_MODE=live
IYZICO_API_KEY=GERCEK_API_KEY_BURAYA
IYZICO_SECRET_KEY=GERCEK_SECRET_BURAYA
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_TIMEOUT=20
ORDER_EXPIRE_MINUTES=120

# E-posta — gerçek SMTP (SPF/DKIM/DMARC DNS kayıtları: docs/go-live-checklist.md §E)
MAIL_DRIVER=smtp
MAIL_FROM=no-reply@orneksite.com
MAIL_FROM_NAME=Ornek Mağaza
SMTP_HOST=smtp.ornekmailservisi.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=no-reply@orneksite.com
SMTP_PASSWORD=SMTP_PAROLASI

# AŞAMA 6 — Tedarikçi / bildirim
SUPPLIER_SEND_TIMEOUT=15

# AŞAMA 6 — Yedekleme (scripts/backup-database.sh + cron/backup-daily.sh)
# Saklama süresi (gün)
RETENTION_DAYS=14
# Offsite kancası — {} yedek dosya yoluyla değiştirilir; boşsa atlanır (offsite=skipped)
# rclone:  rclone copy {} uzaknesne:xml-backup
# rsync:   rsync -a -e "ssh -i /home/deploy/.ssh/id_ed25519" {} backup@nas:/mnt/backup/xml/
# aws:     aws s3 cp {} s3://ornek-yedek/xml/ --storage-class STANDARD_IA
BACKUP_OFFSITE_CMD=
# Yedek şifreleme (opsiyonel): alıcı e-postası/fingerpring — varsa .sql.gz.gpg üretilir
BACKUP_GPG_RECIPIENT=
