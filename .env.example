# ============================================================
# XML E-Ticaret — Ortam Değişkenleri (örnek)
# Kurulum: cp .env.example .env  → değerleri düzenle
# GİZLİ: Bu dosya asla Git'e girmemeli / web kökünde olmamalı.
# ============================================================

# Uygulama
APP_ENV=local                 # local | staging | production
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Istanbul
# APP_KEY: openssl rand -base64 32 çıktısı (32+ byte)
APP_KEY=

# Veritabanı (MySQL 8+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xml_ecommerce
DB_USERNAME=ecommerce_app
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Oturum / Güvenlik
SESSION_NAME=xmlshop_session
SESSION_SECURE=auto           # auto | true | false (HTTPS'te true önerilir)
SESSION_LIFETIME=2700         # saniye (45 dk)

# AŞAMA 6 — Taşıma güvenliği (opt-in; boş = kapalı, production'da önerilir)
# true iken HTTPS olmayan istek 301 ile https://… yönlendirilir (X-Forwarded-Proto destekli)
APP_FORCE_HTTPS=
# Virgülle ayrılmış izinli hostlar; Host/X-Forwarded-Host listede değilse 400 döner
# (host-header injection / cache-poisoning karşıtı). Örn: shop.example.com,www.shop.example.com
APP_ALLOWED_HOSTS=

# Log
LOG_LEVEL=info                # debug | info | warning | error

# XML import
XML_UPLOAD_MAX_MB=100
XML_FETCH_TIMEOUT=30
XML_FETCH_MAX_REDIRECT=3
XML_MAX_MEMORY_MB=256

# XML senkronizasyon (Aşama 2)
XML_SYNC_BATCH=50            # parçalı işlem blok boyutu (idempotent upsert)
XML_PREVIEW_ROWS=20          # aktarım önizlemesinde gösterilecek satır
XML_RATE_USD=34.0            # XML para birimi çevirim katsayıları (satır bazında uygulanır)
XML_RATE_EUR=37.0
XML_RATE_GBP=43.0

# Fiyatlandırma (Aşama 2)
PRICING_TAX_IN_SALE=0        # 1 = hesaplanan satış fiyatı KDV dahil saklanır
PRICING_PROFIT_WARN=10       # kârlılık eşiği uyarısı (%) — altındaki ürünler işaretlenir

# İlk seed (yalnız database/seed.php ilk çalıştırmada kullanılır, sonra .env'den çıkarın)
ADMIN_NAME=Site Yöneticisi
ADMIN_EMAIL=admin@example.local
# Boş bırakılırsa seed rastgele şifre üretip stdout'a YAZAR (tek sefer)
ADMIN_PASSWORD=

# AŞAMA 4 — iyzico Checkout Form (resmî doküman: docs.iyzico.com)
# mod: mock (API çağrısı yok — simülasyon/test) | sandbox | live
# ASLA gerçek üretim anahtarını repoya koymayın; secret yalnız sunucuda kalır.
IYZICO_MODE=mock
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_TIMEOUT=20
# Ödemesi bu süre (dk) içinde tamamlanmayan pending_payment siparişleri cron ile iptal edilir
ORDER_EXPIRE_MINUTES=120
